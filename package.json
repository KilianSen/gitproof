{
  "name": "gitproof",
  "version": "0.1.0",
  "private": true,
  "description": "Renders a user's git contributions between two commits as an embeddable SVG — proof of what you contributed.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gitproof": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "generate": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "hono": "^4.12.29",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
